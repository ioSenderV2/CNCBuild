# VS Code Local History - an embedded git repo, never ours to track
.history/

# Claude Code - per-turn state is regenerated every turn; settings.json and
# turn-config.json ARE tracked (see claude-hub/playbooks/onboard_a_project.md)
.claude/turn-state.json
**/.claude/turn-state.json
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# kicad-cli writes <name>-erc.rpt / <name>-drc.rpt into the working directory when
# --output is omitted. Generated on demand - regenerate, do not track.
*-erc.rpt
*-drc.rpt
